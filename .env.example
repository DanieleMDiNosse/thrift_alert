# Copy to .env and fill in. The real .env is git-ignored.
# NOTE: no inline comments after values — Docker's env-file parsing keeps everything
# after '=' as the value (including a trailing '# ...'), so comments go on their own line.

# --- distribution ---
# Which release to run: pin an exact version (e.g. 1.0.0) or use 'latest'.
SUBITOO_VERSION=2

# --- core ---
# Timezone for cron and logs.
TZ=Europe/Rome
DB_PATH=/data/subitoo.db
# Source-local instead: DB_PATH=./data/subitoo.db
LOG_LEVEL=INFO
# How often ofelia wakes the dispatcher (ofelia schedule syntax). Default every 1m.
OFELIA_SCHEDULE=@every 1m
# watchdog: stale 'running' -> 'error' (seconds)
RUN_TIMEOUT=900

# --- fetching ---
# curl_cffi TLS/JA3 target for the HTTP (browserless) path; firefox to match Camoufox
IMPERSONATE=firefox
# optional shared egress (HTTP client AND browser), e.g. http://user:pass@host:port
PROXY_URL=

# --- browser service (Camoufox, a hardened Firefox, as a Playwright WS server) ---
# pluggable backend (Decision 12/19)
# Docker: camoufox. Source-local ordinary Playwright Firefox: local.
BROWSER_BACKEND=camoufox
BROWSER_WS_URL=ws://subitoo_browser:1234/hello
# Camoufox headless (boolean). false = headed in the container's Xvfb display
# (default); true = Camoufox's patched headless mode.
CAMOUFOX_HEADLESS=false

# --- notifications ---
# Which channel is active. One at a time: pushover | ntfy
DEFAULT_CHANNEL=ntfy
PUSHOVER_TOKEN=
PUSHOVER_USER=
# ntfy: only the topic is required. The topic name IS the secret on the public
# server — anyone who knows it can read your alerts — so make it long and random.
NTFY_TOPIC=
# Leave as-is for ntfy.sh, or point at your own server.
NTFY_URL=https://ntfy.sh
# Only needed for a protected topic (access token).
NTFY_TOKEN=

# --- optional shopping assistant: product reviews ("Recensisci") ---
# On-demand: triggered only when clicking "Recensisci" on a listing in the GUI.
# No automatic background crawling or scoring. Monitoring remains independent.
AI_WORKFLOW=on_demand
AI_WORTH_TTL_HOURS=24
AI_ENABLED=false

# Choose your AI provider: hermes | openai | local
AI_PROVIDER=hermes

# -----------------------------------------------------------------------------
# PROVIDER 1: hermes (Recommended if you already use Hermes CLI with Codex)
# -----------------------------------------------------------------------------
# Reuses the authenticated OpenAI Codex session from Hermes. No API key needed!
# 1) AI_HERMES_HOME: absolute path to the directory containing auth.json
#    - Main profile: AI_HERMES_HOME=/home/<user>/.hermes
#    - Named profile: AI_HERMES_HOME=/home/<user>/.hermes/profiles/<profile_name>
#    Verify with: ls -la ~/.hermes/auth.json or ~/.hermes/profiles/*/auth.json
# 2) AI_HERMES_PYTHON: absolute path to Hermes runtime Python executable
#    Verify by running inside the Hermes environment:
#    python -c 'import sys; print(sys.executable)'
AI_HERMES_PYTHON=
AI_HERMES_HOME=

# -----------------------------------------------------------------------------
# PROVIDER 2: openai (Standard OpenAI API Key)
# -----------------------------------------------------------------------------
# If you don't use Hermes or prefer a direct OpenAI developer key:
# Set AI_PROVIDER=openai and supply your key from https://platform.openai.com
# AI_ENDPOINT=https://api.openai.com/v1
# AI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# PROVIDER 3: local (Self-hosted llama.cpp / Ollama)
# -----------------------------------------------------------------------------
# Set AI_PROVIDER=local, no credentials required.
# AI_ENDPOINT=http://127.0.0.1:8080/v1
# AI_MODEL=underdog-saluki-27b-iq2

AI_ENDPOINT=https://api.openai.com/v1
AI_MODEL=gpt-6.1-sol
AI_REASONING_EFFORT=low
AI_API_KEY=
# Provider calls are bounded; manual requests require valid backend credentials.
AI_TIMEOUT=300
AI_MAX_TOKENS=4096
# Codex OAuth has no supported hard token cap: bounded by timeout/output bytes.
AI_RETRIES=0
AI_MAX_CONTEXT_CHARS=48000
# Local fallback only: AI_PROVIDER=local, local endpoint/model configured explicitly.
# GPT uses strict JSON schemas; AI_THINKING applies only to llama.cpp requests.
AI_STRUCTURED_OUTPUT=true
AI_THINKING=false
AI_SEARCH_BACKEND=ddgs
# Optional alternative: AI_SEARCH_BACKEND=searxng, trusted operator URL below.
AI_SEARXNG_URL=
AI_MAX_SOURCES=5
AI_SEARCH_LIMIT=5
AI_RESEARCH_TTL_DAYS=90
AI_MAX_PENDING_JOBS=1000
AI_MAX_ATTEMPTS=3
AI_DISCOVER_SECONDS=60
AI_DISCOVERY_BATCH_SIZE=5
AI_IDENTIFICATION_BACKLOG=10
AI_POLL_SECONDS=3
AI_LOCK_PATH=./data/ai-inference.lock
