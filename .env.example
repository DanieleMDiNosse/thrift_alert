# Copia questo file in .env e compila i campi necessari. Il file .env reale è ignorato da git.
# NOTA: non inserire commenti inline dopo i valori, i commenti devono stare su una riga dedicata.

# --- Distribuzione ---
# Versione del software da eseguire (es. 2 o 'latest').
SUBITOO_VERSION=2

# --- Configurazione di Base (Core) ---
# Fuso orario per pianificazioni cron e log.
TZ=Europe/Rome
# Percorso del database SQLite.
# Per esecuzione Docker: DB_PATH=/data/subitoo.db
# Per esecuzione locale diretta: DB_PATH=./data/subitoo.db
DB_PATH=./data/subitoo.db
LOG_LEVEL=INFO
# Intervallo risveglio dispatcher: default ogni 1 minuto.
OFELIA_SCHEDULE=@every 1m
# Timeout watchdog per job interrotti (in secondi).
RUN_TIMEOUT=900

# --- Recupero Annunci (Fetching HTTP) ---
# Target TLS/JA3 di curl_cffi per il client HTTP; impostato su firefox per allinearsi al browser.
IMPERSONATE=firefox
# Proxy opzionale (condiviso tra client HTTP e browser), es. http://user:pass@host:port
PROXY_URL=

# --- Servizio Browser (Camoufox / Playwright Firefox) ---
# Backend del browser: 'local' per esecuzione locale con Playwright; 'camoufox' per Docker.
BROWSER_BACKEND=local
BROWSER_WS_URL=ws://subitoo_browser:1234/hello
# Modalità headless del browser (true = senza finestra grafica visibile; false = con finestra).
CAMOUFOX_HEADLESS=false

# --- Notifiche ---
# Canale di notifica attivo (uno alla volta: ntfy | pushover).
DEFAULT_CHANNEL=ntfy
PUSHOVER_TOKEN=
PUSHOVER_USER=
# ntfy: è richiesto solo il nome del topic. Il nome del topic è il segreto sul server pubblico:
# chiunque lo conosca può leggere gli avvisi, quindi scegline uno lungo e casuale.
NTFY_TOPIC=
# URL del server ntfy (lascia ntfy.sh o inserisci il tuo server self-hosted).
NTFY_URL=https://ntfy.sh
# Token di accesso (necessario solo per topic protetti su server autenticati).
NTFY_TOKEN=

# --- Assistente Shopping AI: Recensioni Prodotto ("Recensisci") ---
# Modalità on-demand: si attiva solo cliccando esplicitamente su "Recensisci" nella dashboard.
# Nessuna scansione automatica continua in background.
AI_WORKFLOW=on_demand
AI_WORTH_TTL_HOURS=24
AI_ENABLED=false

# Scegli il tuo provider AI: hermes | openai | local
AI_PROVIDER=hermes

# -----------------------------------------------------------------------------
# PROVIDER 1: hermes (Consigliato se usi la CLI di Hermes con login Codex)
# -----------------------------------------------------------------------------
# Riutilizza la sessione OpenAI Codex autenticata in Hermes. Nessuna API key richiesta!
# 1) AI_HERMES_HOME: percorso assoluto alla cartella che contiene auth.json
#    - Profilo predefinito: AI_HERMES_HOME=/home/<utente>/.hermes
#    - Profilo specifico:   AI_HERMES_HOME=/home/<utente>/.hermes/profiles/<nome_profilo>
#    Verifica con: ls -la ~/.hermes/auth.json oppure ls -la ~/.hermes/profiles/*/auth.json
# 2) AI_HERMES_PYTHON: percorso assoluto all'eseguibile Python dell'ambiente Hermes
#    Verifica eseguendo nell'ambiente Hermes:
#    python -c 'import sys; print(sys.executable)'
AI_HERMES_PYTHON=
AI_HERMES_HOME=

# -----------------------------------------------------------------------------
# PROVIDER 2: openai (Chiave API standard di OpenAI)
# -----------------------------------------------------------------------------
# Se non utilizzi Hermes o preferisci una chiave API per sviluppatori:
# Imposta AI_PROVIDER=openai e inserisci la tua chiave generata su https://platform.openai.com
# AI_ENDPOINT=https://api.openai.com/v1
# AI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# PROVIDER 3: local (Modello self-hosted con llama.cpp / Ollama)
# -----------------------------------------------------------------------------
# Imposta AI_PROVIDER=local, nessuna credenziale richiesta.
# AI_ENDPOINT=http://127.0.0.1:8080/v1
# AI_MODEL=underdog-saluki-27b-iq2

AI_ENDPOINT=https://api.openai.com/v1
AI_MODEL=gpt-6.1-sol
AI_REASONING_EFFORT=low
AI_API_KEY=
# Parametri di controllo inferenza e limiti
AI_TIMEOUT=300
AI_MAX_TOKENS=4096
AI_RETRIES=0
AI_MAX_CONTEXT_CHARS=48000
AI_STRUCTURED_OUTPUT=true
AI_THINKING=false
AI_SEARCH_BACKEND=ddgs
AI_SEARXNG_URL=
AI_MAX_SOURCES=5
AI_SEARCH_LIMIT=5
AI_RESEARCH_TTL_DAYS=90
AI_MAX_PENDING_JOBS=1000
AI_MAX_ATTEMPTS=3
AI_DISCOVER_SECONDS=60
AI_DISCOVERY_BATCH_SIZE=5
AI_IDENTIFICATION_BACKLOG=10
AI_POLL_SECONDS=3
AI_LOCK_PATH=./data/ai-inference.lock
